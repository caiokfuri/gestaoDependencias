@startuml
!include estilo.puml
title DepGraph — Uma chamada recursiva de buscar()
start
if (Todos os nomes têm versão?) then (sim)
 :Construir Graph e executar kahn();
 if (Ordem completa?) then (sim)
  :Retornar seleção, grafo e ordem;
 else (não)
  :Reconstruir ciclo com dfs_ciclo();
  :Registrar falha e retornar None;
 endif
 stop
else (não)
 :Escolher primeiro nome ainda pendente;
endif
:Filtrar candidatos pelas restrições;
if (Há candidatos?) then (não)
 :Registrar ausência ou incompatibilidade de versão;
 stop
endif
while (Há candidato não tentado?) is (sim)
 :Incrementar tentativas;
 if (Tentativas superiores ao limite?) then (sim)
  :Interromper busca com diagnóstico inconclusivo;
  stop
 endif
 if (Conflito ou versão escolhida incompatível?) then (sim)
  :Registrar diagnóstico do candidato;
 else (não)
  :Copiar seleção, ampliar restrições e chamar buscar();
  if (Chamada retornou solução?) then (sim)
   :Retornar solução;
   stop
  endif
 endif
endwhile (não)
:Retornar None ao chamador;
stop
@enduml
