@startuml
!include estilo.puml
title DepGraph — Uma chamada recursiva de search()
start
if (Tentativas >= limite ou selecionados >= 200?) then (sim)
 :Registrar resultado inconclusivo;
 stop
else (não)
endif
:Agrupar requisitos por nome;
if (Versão selecionada viola requisito\nou há conflito declarado?) then (sim)
 :Registrar falha do ramo;
 stop
else (não)
endif
if (Todos os nomes têm versão?) then (sim)
 :Construir Graph de dependências;
 :Executar kahn();
 if (Há ciclo?) then (sim)
  :Obter caminho com dfs_cicle();
  :Registrar falha por ciclo;
 else (não)
  :Criar Plan válido com ordem e ações;
 endif
 stop
else (não)
endif
:Escolher primeiro nome ainda não selecionado;
:Filtrar candidatos pelas restrições;
if (Não há candidatos?) then (sim)
 :Registrar versão incompatível ou ausência;
 stop
else (não)
endif
while (Há candidato não tentado?) is (sim)
 if (Tentativas >= limite?) then (sim)
  :Registrar resultado inconclusivo;
  stop
else (não)
 endif
 :Incrementar tentativas;
 :Chamar search() com nova seleção\ne lista de requisitos ampliada;
 if (Chamada retornou solução?) then (sim)
  :Retornar solução;
  stop
else (não)
 endif
 :Tentar candidato seguinte, sem reutilizar\na seleção ou requisitos do ramo falho;
endwhile (não)
:Retornar None ao chamador;
stop
@enduml
