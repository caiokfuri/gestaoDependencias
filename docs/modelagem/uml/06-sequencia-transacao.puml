@startuml
!include estilo.puml
title DepGraph — Transação implementada em Session
actor Usuário as U
boundary PackagePreview as I
control Session as S
entity Catalog as C
U -> I : Próximo pacote
alt Pedido editado
 I --> U : Exigir nova análise
else Pedido inalterado
 I -> S : advance()
 alt Sem plano válido
  S --> I : ValueError
 else applied=true
  S --> I : None; nenhuma nova operação
 else installed diferente de plan.base
  S --> I : ValueError; exigir análise
 else Zero ações pendentes
  S -> C : validate_state(installed)
  alt Validação recusada
   C --> S : ValueError
   S --> I : Erro; preservar estado e progresso
  else Estado válido
   S -> S : applied=true
   S --> I : None
  end
 else Há ação pendente
  S -> S : Conferir dependências no estado temporário
  alt Pré-requisito inválido
   S --> I : ValueError; não preparar
  else Última ação e pré-requisitos satisfeitos
   S -> C : validate_state(final)
   alt Validação recusada
    C --> S : ValueError
    S --> I : Erro; preservar installed, staged e history
   else Estado válido
    S -> S : Registrar preparo; confirmar installed;\nmarcar applied; registrar conclusão
    S --> I : Nome preparado
   end
  else Ação intermediária e pré-requisitos satisfeitos
   S -> S : Registrar preparo e histórico;\npreservar installed
   S --> I : Nome preparado
  end
 end
 I --> U : Progresso ou diagnóstico
end
@enduml
