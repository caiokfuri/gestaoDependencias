@startuml
!include estilo.puml
!pragma layout elk
title DepGraph — Classes do núcleo implementadas
class PackagePreview {
 +planned_text: str
 +analyze()
 +advance()
 +removal()
 +render()
 +save()
}
class Session {
 +installed: dict
 +staged: list
 +applied: bool
 +history: list
 +analyze(text): Plan
 +advance()
}
class Catalog {
 +packages: dict
 +plan(requests, installed, limit): Plan
 +validate_state(installed)
 +removal_impact(name, installed)
}
class Graph {
 +vertices: dict
 +predecessores: dict
 +nodes: dict
 +edges: dict
 +add_vertice(v)
 +add_aresta(u, v)
 +geracoes(): list
 +kahn(): list
 +dfs_cicle(): list
 +dependentes(v): set
}
class Plan
class CycleError
PackagePreview --> "1" Session : session
PackagePreview --> "1" Catalog : catalog
Session --> "1" Catalog : catalog
Session --> "0..1" Plan : plan
Catalog ..> Graph : constrói e consulta
Plan --> "1" Graph : graph
PackagePreview ..> Graph : layout próprio
Graph ..> CycleError : lança em Kahn
note bottom of Session
 Transação é responsabilidade de Session.
 Não há classe Transacao ou Resolvedor separada.
 Pedido editado: bloqueio em PackagePreview.
 Base alterada: bloqueio em Session.
end note
@enduml
