@startuml
!include estilo.puml
!pragma layout elk
skinparam packageStyle rectangle
title DepGraph — Módulos implementados
component "depgraph.__main__\nentrada: python -m depgraph" as Entry
component "depgraph.app\ninterface, cenários, exportação" as UI
component "Matplotlib\nprimitivas de desenho e controles" as Plot
component "depgraph.model\ncatálogo, busca, plano e sessão" as Core
component "graph.py\nGraph, DFS, Kahn e dependentes" as G
artifact "depgraph/examples/pacotes.json" as Data
artifact "outputs/depgraph\nJSON e PNG" as Out
Entry ..> UI
UI ..> Core
UI ..> Plot
UI ..> Out
Core ..> G
Core ..> Data
note bottom of G
 Estruturas e algoritmos próprios.
 O núcleo não importa Matplotlib ou NetworkX.
end note
@enduml
