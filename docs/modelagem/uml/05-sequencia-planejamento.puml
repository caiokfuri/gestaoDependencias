@startuml
!include estilo.puml
title DepGraph — Planejamento
actor Usuário as U
boundary PackagePreview as I
control Session as S
entity Catalog as C
participant Graph as G
U -> I : Analisar instalação
I -> S : analyze(request_box.text)
S -> S : Interpretar nomes e restrições
alt Pedido inválido
 S -> S : Invalidar plano e preparação
 S --> I : ValueError
else Pedido válido
 S -> C : plan(requests, cópia de installed)
 loop Busca por versões
  C -> C : Verificar candidatos, restrições e conflitos
  alt Seleção completa
   C -> G : Montar grafo e chamar kahn()
   G --> C : sucesso, ordem, camadas
   opt sucesso=false
    C -> G : dfs_ciclo()
    G --> C : Caminho fechado
   end
  else Nome pendente
   C -> C : Tentar próximo candidato com cópias de ramo
  end
 end
 C --> S : Plan válido, bloqueado ou inconclusivo
 S --> I : Plan
 I -> I : Atualizar planned_text e redesenhar
end
I --> U : Plano ou mensagem de erro
@enduml
